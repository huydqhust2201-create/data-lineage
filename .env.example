# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini

# ---- Database (lưu đồ thị lineage — src/services/storage_service.py) ----
# Chạy `docker compose up -d db` để có Postgres cục bộ khớp URL này (cổng 5435,
# tránh 5432/5433 hay bị chiếm bởi Postgres cài native hoặc container khác).
# Nếu 5435 cũng bị chiếm trên máy bạn, đổi cổng ở đây và trong docker-compose.yml
# (mục db.ports) cho khớp nhau.
DATABASE_URL=postgresql://lineage:lineage@localhost:5435/lineage

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Table Description + Semantic Search ----
# TEI chạy trong Docker ở cổng 8080; backend trong compose dùng http://embeddings:80.
DESCRIPTION_ENABLED=true
EMBEDDING_URL=http://localhost:8080
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=30
DESCRIPTION_CONFIDENCE_THRESHOLD=0.7

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Lineage Chatbot ----
CHAT_MAX_EDGES=80
CHAT_ANSWER_TEMPERATURE=0.2
CHAT_SESSION_TTL_SECONDS=1800
CHAT_MAX_HISTORY_TURNS=6
CHAT_MAX_SESSIONS=500
CHAT_MAX_PATHS=3
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_AGENT_STEPS=4
CHAT_SEARCH_LIMIT=20

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO


# ---- Auth ----
# JWT_SECRET: đổi thành chuỗi ngẫu nhiên dài khi deploy thật, không dùng giá trị mặc định.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440
# GOOGLE_CLIENT_ID: tạo tại Google Cloud Console > APIs & Services > Credentials
# > OAuth Client ID (loại Web application).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# AI20K Project — Production Environment (EC2 + docker-compose.prod.yml)
# ============================================
# Copy thành .env trên EC2 (KHÔNG commit .env thật vào git — đã có trong .gitignore).
# Khác .env.example (dev): APP_ENV=production, DESCRIPTION_ENABLED=false,
# CORS_ORIGINS trỏ đúng origin thật, và có POSTGRES_USER/PASSWORD/DB riêng cho
# docker-compose.prod.yml (thay vì hardcode lineage/lineage như bản dev).

# ---- LLM Configuration ----
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini

# ---- Database ----
# QUAN TRỌNG: đổi mật khẩu mặc định trước khi deploy thật. DATABASE_URL bản thân
# KHÔNG cần set ở đây — docker-compose.prod.yml tự ráp từ 3 biến POSTGRES_* bên
# dưới (trỏ vào service "db" trong cùng mạng compose).
POSTGRES_USER=lineage
POSTGRES_PASSWORD=doi-mat-khau-nay-truoc-khi-deploy
POSTGRES_DB=lineage

# ---- Table Description + Semantic Search ----
# Mặc định TẮT trong template này (an toàn cho lần deploy đầu trên EC2 nhỏ).
# Bật = true CHỈ khi EC2 >= t3.medium (4GB RAM) — service "embeddings"
# (TEI + bge-m3) trong docker-compose.prod.yml cần thêm ~2-3GB RAM. Xem
# "Bật bge-m3 / Table Description" trong docs/deploy_aws.md.
DESCRIPTION_ENABLED=false
EMBEDDING_URL=http://embeddings:80
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=30
DESCRIPTION_CONFIDENCE_THRESHOLD=0.7

# ---- App Config ----
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
# Điền IP public (hoặc domain, sau khi có) của EC2 — KHÔNG để localhost/dev origin.
CORS_ORIGINS=http://YOUR_ELASTIC_IP

# ---- Lineage Chatbot ----
CHAT_MAX_EDGES=80
CHAT_ANSWER_TEMPERATURE=0.2
CHAT_SESSION_TTL_SECONDS=1800
CHAT_MAX_HISTORY_TURNS=6
CHAT_MAX_SESSIONS=500
CHAT_MAX_PATHS=3
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_AGENT_STEPS=4
CHAT_SEARCH_LIMIT=20

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Observability (chi can khi bat docker-compose.observability.yml) ----
# Compose se TU CHOI chay neu thieu GRAFANA_ADMIN_PASSWORD - co y, de khong ai
# vo tinh chay Grafana voi admin/admin. Grafana chi bind 127.0.0.1, xem qua
# SSH tunnel; chi tiet trong docs/monitoring.md.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-nay

